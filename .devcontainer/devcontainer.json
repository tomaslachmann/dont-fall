// Online play (ADR 0108): this Codespace runs the same Docker stack as a
// local `docker compose up web` — the game, the builder and the API behind one
// address, port 8088. Creating it installs the workspace (for the scripts);
// every start, waking from sleep included, runs `pnpm run online`, which
// builds and starts the stack, makes 8088 public and logs the link to send to
// /tmp/dont-fall-online.log. `pnpm run online` in a terminal prints it again.
// Always with `run`: a bare `pnpm online` can be taken for `pnpm exec`.
{
  "name": "DON'T FALL — online",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:22-bookworm",
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:2": {}
  },
  "hostRequirements": { "cpus": 2 },
  "containerEnv": { "COREPACK_ENABLE_DOWNLOAD_PROMPT": "0" },
  "postCreateCommand": "command -v pnpm >/dev/null || sudo npm install -g pnpm; pnpm install --frozen-lockfile",
  "postStartCommand": "nohup pnpm run online > /tmp/dont-fall-online.log 2>&1 &",
  "forwardPorts": [8088],
  "portsAttributes": {
    "8088": { "label": "DON'T FALL", "onAutoForward": "silent" }
  }
}
